<form asp-controller="Place" asp-action="Create" method="post">
    <div class="form-group">
        <label for="place_name">Име на мястото</label>
        <input type="text" class="form-control" name="name" id="place_name" placeholder="въведете името на мястото тук">
        <small class="form-text text-muted">Въведете името само на кирилица</small>
    </div>

    <div class="form-group">
        <label for="place_area">Област на мястото</label>
        <input type="text" class="form-control" name="area" id="place_area" placeholder="въведете областта на мястото тук">
    </div>

    <div class="form-group">
        <label for="place_type">Тип на мястото</label>
        <input type="text" class="form-control" name="type" id="place_type" placeholder="въведете типа на мястото тук">
    </div>

    <div class="form-group">
        <label for="place_fee">Входна такса за мястото</label>
        <input type="text" class="form-control" name="fee" id="place_fee" placeholder="въведете входната такса за мястото тук">
    </div>

    <div class="form-group">
        <label for="place_description">Описание на мястото</label>
        <input type="text" class="form-control" name="description" id="place_description" placeholder="въведете описанието на мястото тук">
    </div>

    <button type="submit" class="btn btn-primary my-3">Запази</button>
</form>